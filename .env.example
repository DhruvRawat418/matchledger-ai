# Copy to .env (Git ignores it) and fill in. Never commit real keys.
# Provider: openai | anthropic | gemini
MATCHLEDGER_PROVIDER=
# Exact model identifier from the provider's docs. Recorded in every result.
MATCHLEDGER_MODEL=
# Optional. Leave unset: some current models reject a temperature setting.
# MATCHLEDGER_TEMPERATURE=0

# Only the key for the chosen provider is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional semantic matching (Anthropic); leave blank for deterministic matching only.
MATCHLEDGER_MATCH_MODEL=
